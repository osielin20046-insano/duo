From 85ce0be609b59704fab59f5944310b3762aad669 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 9 Nov 2026 05:50:41 +0000
Subject: [PATCH 2/7] =?UTF-8?q?fix:=20caracteres=20rotos=20por=20codificac?=
 =?UTF-8?q?i=C3=B3n,=20creaci=C3=B3n=20de=20salas=20sin=20sobrescribir=20y?=
 =?UTF-8?q?=20guardado=20concurrente=20seguro?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Corrige ↗ ✳ → que se mostraban como mojibake en la UI
- createRoom usa INSERT (409 si el código existe) con código criptográfico sin caracteres ambiguos
- Las escrituras de sala usan control optimista (campo rev) con reintentos, para que dos personas
  guardando a la vez no se pisen los cambios
- Errores de guardado visibles en el juego de frases y al agregar personas
---
 src/App.tsx     |   8 ++--
 src/services.ts | 124 ++++++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 118 insertions(+), 14 deletions(-)

diff --git a/src/App.tsx b/src/App.tsx
index 33fb4e3..22b0df0 100644
--- a/src/App.tsx
+++ b/src/App.tsx
@@ -9,7 +9,7 @@ import type { Round } from './services'
 
 const variants={initial:{opacity:0,y:12},animate:{opacity:1,y:0,transition:{duration:.35}},exit:{opacity:0,y:-8,transition:{duration:.18}}}
 function Brand({small=false}:{small?:boolean}){return <Link className={`brand ${small?'brand-small':''}`} to="/"><span>DÚO</span><i /></Link>}
-function Header(){const active=getActive(),room=active?getRoom(active.code):null;return <header className="topbar"><Brand/><nav><Link to="/sala">Sala</Link>{room&&<Link to="/juegos">Juegos</Link>}{room&&<Link to="/equipo">Equipo</Link>}</nav><div className="top-actions">{room&&<span className="room-pill"><span className="online-dot"/>Sala {room.code}</span>}<Link className="avatar" to={room?'/equipo':'/sala'}>{room?.members.find(m=>m.id===active?.memberId)?.name.slice(0,1).toUpperCase()||'â†—'}</Link></div></header>}
+function Header(){const active=getActive(),room=active?getRoom(active.code):null;return <header className="topbar"><Brand/><nav><Link to="/sala">Sala</Link>{room&&<Link to="/juegos">Juegos</Link>}{room&&<Link to="/equipo">Equipo</Link>}</nav><div className="top-actions">{room&&<span className="room-pill"><span className="online-dot"/>Sala {room.code}</span>}<Link className="avatar" to={room?'/equipo':'/sala'}>{room?.members.find(m=>m.id===active?.memberId)?.name.slice(0,1).toUpperCase()||'↗'}</Link></div></header>}
 function Page({children}:{children:React.ReactNode}){return <div className="app-shell"><Header/><main>{children}</main><footer><span>Hecho para acercar equipos.</span><span>DÚO <i>·</i> Salas compartidas</span></footer></div>}
 function Home(){return <Page><motion.section className="hero" initial="initial" animate="animate" variants={variants}>
   <div className="hero-copy"><div className="eyebrow"><span className="eyebrow-dot"/> UNA NUEVA FORMA DE CONECTAR</div><h1>El equipo se<br/>conoce <em>jugando.</em></h1><p>Pequeñas dinámicas. Grandes descubrimientos. Un espacio para reír, sorprenderse y conocer a las personas detrás del equipo.</p><div className="hero-buttons"><Link to="/sala" className="button button-primary">Comenzar <ArrowRight size={17}/></Link><a href="#como-funciona" className="button button-quiet">Descubrir DÚO <ArrowUpRight size={16}/></a></div><div className="social-proof"><div className="avatar-stack"><span>V</span><span>M</span><span>A</span><span>+</span></div><span>Mejores conversaciones,<br/><strong>un juego a la vez.</strong></span></div></div>
@@ -20,9 +20,9 @@ function Home(){return <Page><motion.section className="hero" initial="initial"
